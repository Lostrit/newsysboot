# ============ 规则（顺序与 rules.ini 一致）============
rules:
  # 腾讯云内网 / 镜像源：放在最前面，不受后面任何规则（包括广告规则）影响
  - DOMAIN-SUFFIX,tencentyun.com,DIRECT
  - DOMAIN,mirrors.tencent.com,DIRECT
  # github 加速源
  - DOMAIN-SUFFIX,gh-proxy.org,DIRECT
  - DOMAIN-SUFFIX,gh-proxy.com,DIRECT
  - DOMAIN,gh.qninq.cn,DIRECT
  - DOMAIN,github.cnxiaobai.com,DIRECT
  - DOMAIN-SUFFIX,tvv.tw,DIRECT

  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve # 腾讯云元数据、内网 DNS 等链路本地地址
  - RULE-SET,LocalAreaNetwork,DIRECT
  - RULE-SET,UnBan,DIRECT
  - RULE-SET,AdvertisingLite,AD
  - RULE-SET,AdGuardSDNSFilter,AD
  # 国内
  - RULE-SET,GoogleCN,DIRECT
  - RULE-SET,SteamCN,DIRECT
  - RULE-SET,ChinaDomain,DIRECT
  - RULE-SET,ChinaCompanyIp,DIRECT
  - RULE-SET,Download,DIRECT
  - RULE-SET,China,DIRECT
  - RULE-SET,ChinaIPs,DIRECT,no-resolve
  # 海外服务
  - RULE-SET,OpenAI,PROXY
  - RULE-SET,Gemini,PROXY
  - RULE-SET,Claude,PROXY
  - RULE-SET,Anthropic,PROXY
  - RULE-SET,Copilot,PROXY
  - RULE-SET,YouTube,PROXY
  - RULE-SET,Microsoft,DIRECT
  - RULE-SET,OneDrive,DIRECT
  - RULE-SET,Google,PROXY
  - RULE-SET,GoogleFCM,PROXY
  - RULE-SET,Apple,DIRECT
  - RULE-SET,Netflix,PROXY
  - RULE-SET,TikTok,PROXY
  - RULE-SET,Instagram,PROXY
  - RULE-SET,Threads,PROXY
  - RULE-SET,ProxyMedia,PROXY
  # 国内媒体
  - RULE-SET,BiliBili,DIRECT
  - RULE-SET,ChinaMedia,DIRECT
  - RULE-SET,NetEaseMusic,DIRECT
  # 其他
  - RULE-SET,Telegram,PROXY
  - RULE-SET,WeChat,DIRECT
  - RULE-SET,Speedtest,PROXY
  - RULE-SET,ProxyGFWlist,PROXY
  - RULE-SET,cn-ip,DIRECT
  - MATCH,PROXY
