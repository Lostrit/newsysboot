{%- set port = vars.mihomo_mixed_port | default(value="") -%}
{%- if port -%}
# dockerd 代理（由 bootstrap 生成）：registry-mirrors 不可用或缺镜像时，经本机 mihomo 回源 Docker Hub
[Service]
Environment="HTTP_PROXY=http://127.0.0.1:{{ port }}"
Environment="HTTPS_PROXY=http://127.0.0.1:{{ port }}"
Environment="NO_PROXY=localhost,127.0.0.0/8,::1{% for m in vars.docker_registry_mirrors | split(pat=",") %}{% if m %},{{ m | replace(from="https://", to="") | replace(from="http://", to="") | split(pat="/") | first }}{% endif %}{% endfor %}"
{% endif -%}
