# dockerd 代理（仅在启用 mihomo 模块时写入）：registry-mirrors 不可用或缺镜像时，经本机 mihomo 回源 Docker Hub
[Service]
Environment="HTTP_PROXY=http://127.0.0.1:{{ vars.mihomo_mixed_port }}"
Environment="HTTPS_PROXY=http://127.0.0.1:{{ vars.mihomo_mixed_port }}"
Environment="NO_PROXY=localhost,127.0.0.0/8,::1{% for m in vars.docker_registry_mirrors %},{{ m | replace(from="https://", to="") | split(pat="/") | first }}{% endfor %}"
